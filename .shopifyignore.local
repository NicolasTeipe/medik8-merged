# IMPORTANT: Please do the following BEFORE you commit anything to git.

# In your terminal, run 'git update-index --skip-worktree .shopifyignore'.
# Replace the contents of .shopifyignore with this file.

# This allows you to keep a local .shopifyignore config that is different
# to the remote & ensures updates either way do not overwrite the other version.

# ---------------------------------------------------------------------
# ---------------------------------------------------------------------

# Version: 1.0

# This ignore script is configured to pull in only the following files
# - config/settings_data.json
# - templates/*.json
# - locales/*.json

# It does it a little backwards because the shopifyignore file doesn't seem to
# support `!` to not ignore a file.

assets/
config/settings_schema.json
layout/
sections/*.liquid
snippets/
templates/*.liquid

# Include non-Shopify folders as there is a bug whereby
# 'shopify theme pull' will sync .json files across the repo so
# even .json files that are not a part of the standard Shopify
# theme folder structure will still be sync'd, and thus deleted.
js/
styles/
util/

# include any .json files found in the root of the theme
package.json
package-lock.json